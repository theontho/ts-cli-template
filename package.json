{
  "name": "typescript-cli-template",
  "version": "0.1.0",
  "type": "module",
  "description": "Best-practice TypeScript CLI project template",
  "main": "dist/index.js",
  "bin": {
    "typescript-cli-template": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "theontho",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^14.0.0",
    "conf": "^13.0.0",
    "platformdirs": "^4.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/node": "^22.0.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
