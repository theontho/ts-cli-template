{
  "name": "ts-cli-template",
  "version": "0.1.0",
  "module": "src/cli.ts",
  "type": "module",
  "description": "Best-practice Bun-powered TypeScript CLI project template",
  "private": true,
  "packageManager": "bun@1.3.13",
  "bin": {
    "ts-cli-template": "src/cli.ts"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "dev": "bun --watch src/cli.ts",
    "test": "bun test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "ci:check": "biome check .",
    "typecheck": "tsc --noEmit",
    "check:fix": "biome check --write .",
    "build": "bun build ./src/cli.ts --compile --outfile dist/ts-cli-template",
    "dev-register": "bun scripts/dev-register.ts",
    "setup-hooks": "bun scripts/setup-hooks.ts",
    "postinstall": "bun scripts/setup-hooks.ts --auto"
  },
  "author": "theontho",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^15.0.0",
    "platformdirs": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "bun-types": "^1.3.14",
    "lefthook": "^2.1.9",
    "typescript": "^6.0.3"
  }
}
